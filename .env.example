# Required for grounded / general generation. Never commit the real value.
GROQ_API_KEY=

# Optional override for AtlasIQ application LLM (Groq chat model id).
# Default is set in atlas/config.py GenerationConfig.model_id.
# GROQ_MODEL=openai/gpt-oss-120b

# Public / internet hosting (required for safe demo URLs)
# ATLASIQ_APP_PASSWORD=choose-a-strong-password
# ATLASIQ_REQUIRE_AUTH=1

# Optional Streamlit host hints
# STREAMLIT_SERVER_PORT=8501
# STREAMLIT_SERVER_ADDRESS=0.0.0.0
# PORT=8501

# RAG response cache (answers + abstentions). Not a UI-only layer —
# lives in the pipeline so repeats skip retrieve/generate until TTL.
# ATLASIQ_CACHE_ENABLED=1
# ATLASIQ_CACHE_TTL_SECONDS=3600

